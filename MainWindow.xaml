<local:GlassWindow x:Class="OmniDock.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:OmniDock"
                   xmlns:controls="clr-namespace:OmniDock.Controls"
                   Title="OmniDock"
                   Width="296"
                   SizeToContent="Height"
                   Topmost="True"
                   TextOptions.TextFormattingMode="Ideal"
                   KeyDown="OnWindowKeyDown">

    <!-- 只做一层很淡的高光和描边：玻璃的模糊与着色都由 DWM 亚克力提供，
         这层若太厚会把透进来的背景盖住。整体缩放靠 LayoutTransform。 -->
    <Border x:Name="RootBorder"
            Width="296"
            Opacity="0"
            CornerRadius="8"
            BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <!-- 写成元素形式才是可动画的画刷，告警脉冲要改它的 Color -->
        <Border.BorderBrush>
            <SolidColorBrush x:Name="RootBorderBrush" Color="#26FFFFFF" />
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Offset="0" Color="#0EFFFFFF" />
                <GradientStop Offset="1" Color="#02FFFFFF" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="13,10,11,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：状态灯 + 标题，右侧是时间戳和按钮 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF6CD3A6" Margin="0,0,7,0" />
                    <TextBlock Text="额度" Foreground="#F2FFFFFF" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 正常时滚动显示刷新时间：HH:mm:ss 位数固定，每秒只有个位变 -->
                    <controls:RollingNumberText x:Name="StatusClock"
                                                Foreground="#7AFFFFFF"
                                                FontSize="10"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0" />
                    <!-- 异常状态改用普通文本，因为滚动控件没法做省略号截断 -->
                    <TextBlock x:Name="StatusText"
                               Foreground="#7AFFFFFF"
                               FontSize="10"
                               MaxWidth="112"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Margin="0,0,6,0" />
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,3,0"
                            ToolTip="设置"
                            Click="OnSettingsClick">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" />
                    </Button>
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="0,0,3,0"
                            ToolTip="立即刷新 (F5)"
                            Click="OnRefreshClick">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            ToolTip="关闭 (Esc)"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- 各额度窗口；负的下边距用来抵掉最后一项的间隔 -->
            <ItemsControl x:Name="WindowsList" Grid.Row="1" Margin="0,10,0,-9">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,9">
                            <!-- 标题 + 占比滚动数字（跟随水位变色） -->
                            <Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="#EDFFFFFF"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <controls:RollingNumberText Text="{Binding PercentText}"
                                                            Foreground="{Binding BarBrush}"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" />
                            </Grid>

                            <!-- 已用 / 限额，右侧跟重置倒计时 -->
                            <Grid Margin="0,5,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:RollingNumberText Text="{Binding UsedText}"
                                                                Foreground="#F2FFFFFF"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BudgetText}"
                                               Foreground="#8AFFFFFF"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="5,1,0,0" />
                                </StackPanel>
                                <controls:RollingNumberText Text="{Binding ResetText}"
                                                            Foreground="#8AFFFFFF"
                                                            FontSize="10"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" />
                            </Grid>

                            <!-- 两条叠加：半透明的缓冲段是按当前速率预计到重置时会用到的位置，
                                 实色的是当前已用。绑 SmoothProgress.Target 而不是 Value，让水位平滑移动 -->
                            <Grid Margin="0,6,0,0">
                                <ProgressBar Style="{StaticResource UsageBarStyle}"
                                             controls:SmoothProgress.Target="{Binding ProjectedPercent, Mode=OneWay}"
                                             Foreground="{Binding ProjectionBrush}" />
                                <ProgressBar Style="{StaticResource UsageBarStyle}"
                                             Background="Transparent"
                                             controls:SmoothProgress.Target="{Binding Percent, Mode=OneWay}"
                                             Foreground="{Binding BarBrush}" />
                            </Grid>

                            <!-- 消耗速率与耗尽预测。文字结构一直在变，用普通 TextBlock
                                 而不是滚动数字，免得每秒整排重建 -->
                            <TextBlock Text="{Binding ForecastText}"
                                       Foreground="{Binding ForecastBrush}"
                                       FontSize="10"
                                       Margin="0,5,0,0"
                                       ToolTip="{Binding ForecastTip}"
                                       ToolTipService.InitialShowDelay="400"
                                       ToolTipService.ShowDuration="20000" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</local:GlassWindow>
